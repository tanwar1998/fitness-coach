      "label": "Anchored reasoning",
      "fromCol": 2,
      "toCol": 4,
      "variant": "emphasis"
    },
    {
      "id": "reply",
      "label": "Reply",
      "fromCol": 5,
      "toCol": 5,
      "variant": "dashed"
