{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "How the FitPulse Chatbot Works",
    "quality_profile": "standard",
    "views": [
      {
        "id": "happy-path",
        "label": "Message to reply",
        "focus": [
          "chat",
          "message",
          "graph",
          "retrieve",
          "checkin",
          "route",
          "coach",
          "reply"
        ],
        "note": "Follow a message from the chat UI through the graph to a coach reply."
      },
      {
        "id": "interrupt-resume",
        "label": "Interrupt & resume",
        "focus": [
          "interrupt",
          "chat",
          "answer",
          "graph",
          "coach"
        ],
        "note": "See where the graph pauses for a question and resumes through the answer route."
      }
    ]
  },
  "lanes": [
    {
      "id": "ui",
      "label": "Chat UI"
    },
