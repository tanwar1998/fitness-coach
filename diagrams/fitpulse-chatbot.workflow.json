  "edges": [
    {
      "id": "chat-message",
      "from": "chat",
      "to": "message",
      "label": "sendCoachMessage()",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "message-graph",
      "from": "message",
      "to": "graph",
      "label": "invoke",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "graph-retrieve",
      "from": "graph",
      "to": "retrieve",
      "label": "RAG retrieve",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "graph-checkin",
      "from": "retrieve",
      "to": "checkin",
      "variant": "default",
      "role": "main"
    },
    {
      "id": "checkin-route",
      "from": "checkin",
      "to": "route",
      "variant": "default",
      "role": "main"
    },
    {
      "id": "route-coach",
      "from": "route",
      "to": "coach",
      "label": "no plan change",
      "variant": "default",
      "role": "main"
    },
    {
      "id": "route-replan",
      "from": "route",
      "to": "replan",
      "label": "plan change",
      "variant": "default",
      "role": "branch"
    },
    {
      "id": "replan-coach",
      "from": "replan",
      "to": "coach",
      "label": "validated edit",
      "variant": "dashed",
      "role": "return"
    },
    {
      "id": "coach-reply",
      "from": "coach",
      "to": "reply",
      "label": "answer + action",
      "variant": "emphasis",
      "role": "return"
    },
    {
      "id": "coach-gemini",
      "from": "coach",
      "to": "gemini",
      "label": "LLM call",
      "variant": "default",
      "role": "main"
    },
    {
      "id": "graph-index",
      "from": "graph",
      "to": "index",
      "label": "embed query",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "checkin-interrupt",
      "from": "checkin",
      "to": "interrupt",
      "label": "question needed",
      "variant": "dashed",
      "role": "error"
    },
    {
      "id": "interrupt-chat",
      "from": "interrupt",
      "to": "chat",
      "label": "show question",
      "variant": "dashed",
      "role": "return"
    },
    {
      "id": "chat-answer",
      "from": "chat",
      "to": "answer",
      "label": "user answers",
      "variant": "emphasis",
      "role": "branch"
    },
    {
      "id": "answer-graph",
      "from": "answer",
      "to": "graph",
      "label": "resume",
      "variant": "dashed",
      "role": "return"
    },
    {
      "id": "coach-answer",
      "from": "coach",
      "to": "answer",
      "label": "yield · await answer",
      "variant": "dashed",
      "role": "error"
    },
    {
      "id": "coach-fallback",
      "from": "coach",
      "to": "fallback",
      "label": "out of scope",
      "variant": "dashed",
      "role": "error"
    },
    {
      "id": "fallback-reply",
      "from": "fallback",
      "to": "reply",
      "label": "redirect",
      "variant": "dashed",
      "role": "return"
    },
    {
      "id": "graph-sessions",
      "from": "graph",
      "to": "sessions",
      "label": "checkpoint",
      "variant": "dashed",
      "role": "branch"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Anchored reasoning",
      "items": [
        "Query is embedded against an ~860-entry exercise index; top 6 ground the answer",
        "Check-in questions tune energy, pain and time before replanning or coaching"
      ]
    },
    {
      "dot": "amber",
      "title": "Interrupt & resume",
      "items": [
        "A check-in question pauses the graph and returns 409 to the client",
        "The user's answer is posted to /api/coach/answer, which resumes the thread",
        "Out-of-scope requests redirect through a safe fallback instead of an LLM reply"
      ]
    },
    {
      "dot": "emerald",
      "title": "Persistence",
      "items": [
        "Sessions and messages are stored per device in PostgreSQL",
        "LangGraph thread state lives in PostgreSQL checkpoints"
      ]
    }
  ]
}
