# PostgreSQL connection string used by the backend
DATABASE_URL=<postgres-connection-string>
# Set to "true" for managed Postgres (e.g. Neon, Supabase) that requires TLS
# DATABASE_SSL=true

# Default AI provider used when the client does not pick one
# Options: gemini | grok | deepseek
AI_PROVIDER=<gemini|grok|deepseek>

# Google Gemini
GOOGLE_GEMINI_KEY=<google-gemini-api-key>
GEMINI_MODEL=<gemini-model-id>

# Grok (xAI) - optional, OpenAI-compatible
GROK_API_KEY=<xai-api-key>
GROK_MODEL=<grok-model-id>
GROK_BASE_URL=<xai-base-url>

# DeepSeek - optional, OpenAI-compatible
DEEPSEEK_API_KEY=<deepseek-api-key>
DEEPSEEK_MODEL=<deepseek-model-id>
DEEPSEEK_BASE_URL=<deepseek-base-url>

# Model gateway (optional; per-role provider/model overrides)
# AI_ROUTER_PROVIDER=gemini
# AI_ROUTER_MODEL=gemini-3.1-flash-lite-preview
# AI_PLANNER_PROVIDER=gemini
# AI_PLANNER_MODEL=gemini-3.1-flash-lite-preview
# AI_CHAT_PROVIDER=gemini
# AI_CHAT_MODEL=gemini-3.1-flash-lite-preview
# AI_MODEL_FALLBACKS=gemini,deepseek,xai
# AI_REQUEST_TIMEOUT_MS=60000

# AI coach graph v2 (defaults keep the legacy graph)
COACH_GRAPH_MODE=langgraph
# COACH_CHECKPOINTER=memory
COACH_SSE_ENABLED=true

# Optional LangSmith tracing
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=<langsmith-api-key>
